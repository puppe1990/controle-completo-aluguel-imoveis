{
  "name": "controle-completo-aluguel-imoveis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App desktop para gestão imobiliária com Neutralinojs, Tailwind, JavaScript e SQLite.",
  "scripts": {
    "prepare": "husky",
    "postinstall": "npm run copy:neutralino",
    "copy:neutralino": "node scripts/copy-neutralino-lib.js",
    "build:css": "tailwindcss -i ./resources/styles/input.css -o ./resources/styles/output.css --minify",
    "build:assets": "npm run copy:neutralino && npm run build:css",
    "neutralino:update": "neu update",
    "dev:css": "tailwindcss -i ./resources/styles/input.css -o ./resources/styles/output.css --minify --watch",
    "dev:app": "neu run",
    "dev": "node scripts/dev.js",
    "build": "npm run build:assets && neu build --release && node scripts/copy-runtime-source.js",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.7.0",
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.1",
    "@tailwindcss/cli": "^4.1.13",
    "chokidar": "^5.0.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "vitest": "^3.2.4"
  }
}
