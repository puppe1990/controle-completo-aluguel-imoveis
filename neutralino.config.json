{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "js.imobiliaria.desktop",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "clipboard.*",
    "filesystem.*",
    "os.*",
    "window.*",
    "extensions.*"
  ],
  "modes": {
    "window": {
      "title": "Controle Completo de Aluguel de Imoveis",
      "width": 1440,
      "height": 960,
      "minWidth": 1200,
      "minHeight": 760,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": true,
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "extensions": [
    {
      "id": "js.imobiliaria.sqlite",
      "command": "node ${NL_PATH}/extensions/sqlite-bridge/main.js"
    }
  ],
  "cli": {
    "binaryName": "imobiliaria-desktop",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.7.0",
    "clientVersion": "6.7.0"
  }
}
